# Copy to .env and change the values. .env is git-ignored.
# Docker Compose reads it automatically; without it, local defaults are used.
#
# Generate strong values with:  openssl rand -hex 32

# PostgreSQL password (used in DATABASE_URLs, so stick to URL-safe characters)
POSTGRES_PASSWORD=boutique

# Signs user login tokens (auth) and verifies them (other services)
JWT_SECRET=change-me

# Shared token for service-to-service /internal endpoints
INTERNAL_API_TOKEN=change-me

# Grafana admin password (user: admin)
GRAFANA_ADMIN_PASSWORD=admin

# Host port for PostgreSQL. Change it if 5432 is taken by a local PostgreSQL.
# For `npm run dev`, export the same value as PGPORT (e.g. PGPORT=5433 npm run dev).
POSTGRES_PORT=5432
